ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
MAX_IMAGE_SIZE_MB=5
MAX_PDF_SIZE_MB=500
MAX_PDF_PAGES=600
JOB_TTL_SECONDS=300
JOB_PURGE_INTERVAL_SECONDS=60
JOB_STALL_TIMEOUT_SECONDS=1800
PDF_CHUNK_MAX_CONCURRENT_PROCESSING=1
ANTHROPIC_CONCURRENCY=3
MAX_TOKENS=24576

# Timeout d'UNE tentative d'appel Anthropic (secondes), et retry/backoff maison
# pour les erreurs transitoires (429, 5xx, connexion) — voir claude_service.py,
# _create_message_with_retry. ANTHROPIC_MAX_RETRIES = tentatives SUPPLÉMENTAIRES
# après la première.
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_RETRY_BASE_DELAY_SECONDS=1

# Clé partagée que le frontend doit envoyer (header X-API-Key) pour appeler
# cette API — distincte d'ANTHROPIC_API_KEY. Générer une valeur aléatoire,
# p. ex. `python -c "import secrets; print(secrets.token_hex(24))"`, et
# reporter la MÊME valeur dans hakili-ocr/.env (VITE_APP_API_KEY).
APP_API_KEY=your_shared_secret_here

# Origines autorisées par CORS, séparées par des virgules. Défaut : ports Vite
# en dev local. En Docker, inclure l'origine publiée du frontend (ex. celle
# définie par FRONTEND_PORT dans le .env racine, voir docker-compose.yml).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
