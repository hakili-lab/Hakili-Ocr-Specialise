# Variables lues par docker-compose.yml. Copier en .env (jamais commité) et
# remplir les valeurs réelles.
#
# Détail de chaque variable backend : voir ocr-math-api/.env.example
# Détail de chaque variable frontend : voir hakili-ocr/.env.example

# --- Backend (service "backend", passées via env_file) ---
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
MAX_IMAGE_SIZE_MB=5
MAX_PDF_SIZE_MB=500
MAX_PDF_PAGES=600
JOB_TTL_SECONDS=300
JOB_PURGE_INTERVAL_SECONDS=60
JOB_STALL_TIMEOUT_SECONDS=1800
PDF_CHUNK_MAX_CONCURRENT_PROCESSING=1
ANTHROPIC_CONCURRENCY=3
MAX_TOKENS=24576
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_RETRY_BASE_DELAY_SECONDS=1

# Clé partagée frontend -> backend (header X-API-Key). Générer une valeur
# aléatoire, p. ex. `python -c "import secrets; print(secrets.token_hex(24))"`.
# Réutilisée telle quelle pour VITE_APP_API_KEY ci-dessous (build arg du
# frontend) : une seule valeur à changer aux deux endroits.
APP_API_KEY=your_shared_secret_here

# Origine publiée du frontend (voir le port hôte du service "frontend" dans
# docker-compose.yml — 8021 actuellement) — nécessaire pour que le navigateur
# passe le CORS en appelant le backend. Doit rester synchronisé avec
# docker-compose.yml : un décalage entre les deux fait échouer silencieusement
# toutes les requêtes (déjà arrivé une fois sur ce projet).
ALLOWED_ORIGINS=http://localhost:8021

# --- Frontend (service "frontend") ---
# Origine publiée du backend (port hôte du service "backend" dans
# docker-compose.yml — 8020 actuellement) telle que vue depuis le navigateur
# de l'utilisateur, pas depuis l'intérieur du réseau Docker. Utilisée à deux
# endroits : (1) baked dans le bundle au build de l'image (VITE_*), un rebuild
# du frontend est nécessaire après tout changement ; (2) injectée au runtime
# dans le `connect-src` du CSP nginx (via API_ORIGIN, voir docker-compose.yml)
# — un simple redémarrage du conteneur suffit pour ce second usage.
VITE_API_BASE_URL=http://localhost:8020
